{
  "_deprecatedChunkerNote": "DEPRECATED: @vivantel/virage-chunker-ce-md was removed (ADR-051, migrated into virage-engine's builtin md chunker). This suite is a historical/archival config, not executed by any live script in this repo (checked before annotating) - not rewired to a v2-equivalent invocation, since no v2 eval-runner replacement exists yet. Left as documentation of the last-working v1 config, not a runnable one.",
  "version": "1",
  "dataset": "../quality-evaluation.ds.json",
  "topK": 10,
  "baseline": "vector",
  "ciGate": {
    "mrr": 0.35
  },
  "cacheDir": "../../.virage/eval-cache",
  "exclude": [
    "**/*.a",
    "**/*.class",
    "**/*.generated.cs",
    "**/*.lock",
    "**/*.min.css",
    "**/*.min.js",
    "**/*.o",
    "**/*.pb.cs",
    "**/*.pb.go",
    "**/*.pb.ts",
    "**/.next/**",
    "**/.turbo/**",
    "**/CMakeFiles/**",
    "**/bin/**",
    "**/cmake-build-*/**",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/target/**",
    "**/yarn.lock"
  ],
  "filesets": {
    "md": {
      "include": [
        "**/*.md",
        "**/*.mdx"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/vendor/**",
        "**/dist/**",
        "**/out/**",
        "CHANGELOG.md"
      ]
    },
    "ts": {
      "include": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/vendor/**",
        "**/dist/**",
        "**/out/**",
        "**/*.d.ts"
      ]
    },
    "js": {
      "include": [
        "**/*.js",
        "**/*.jsx"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/vendor/**",
        "**/dist/**",
        "**/out/**"
      ]
    }
  },
  "chunkers": {
    "md": "@vivantel/virage-chunker-ce-md",
    "ts": "@vivantel/virage-code-chunk-chunker",
    "js": "@vivantel/virage-code-chunk-chunker"
  },
  "databases": {
    "minilm-384-ast": {
      "url": "https://github.com/vivantel/virage/releases/download/eval-db-2026-08-14-b2b284a1/minilm-384-ast.tar.gz",
      "description": "all-MiniLM-L6-v2 384d, AST+Markdown chunking, virage master branch",
      "embedder": {
        "package": "@vivantel/virage-embedder-transformers",
        "config": {
          "model": "Xenova/all-MiniLM-L6-v2",
          "dimensions": 384
        }
      },
      "vectorStore": {
        "package": "@vivantel/virage-store-lancedb"
      },
      "sha256": "f0f36209b840de135bfed52c5e02e1d868bacab74f2d3bc2c28f9a66bf740672",
      "pluginVersions": {
        "@vivantel/virage-agent-antigravity": "0.1.12",
        "@vivantel/virage-agent-claude": "0.2.31",
        "@vivantel/virage-agent-codex": "0.1.12",
        "@vivantel/virage-agent-copilot": "0.1.12",
        "@vivantel/virage-agent-core": "0.1.8",
        "@vivantel/virage-chunker-ce-ast": "0.1.33",
        "@vivantel/virage-chunker-ce-md": "0.1.11",
        "@vivantel/virage-cli": "0.3.17",
        "@vivantel/virage-code-chunk-chunker": "0.1.74",
        "@vivantel/virage-core": "0.4.14",
        "@vivantel/virage-embedder-transformers": "0.3.14",
        "@vivantel/virage-reranker-cross-encoder": "0.2.14",
        "@vivantel/virage-skills": "0.1.10",
        "@vivantel/virage-store-lancedb": "0.3.15"
      }
    }
  },
  "variants": [
    {
      "name": "vector",
      "database": "minilm-384-ast",
      "description": "Pure vector search (cosine)"
    },
    {
      "name": "hybrid",
      "database": "minilm-384-ast",
      "description": "Hybrid BM25 + vector via RRF (alpha=0.6)",
      "search": {
        "hybrid": true,
        "hybridAlpha": 0.6
      }
    },
    {
      "name": "vector-ce",
      "database": "minilm-384-ast",
      "description": "Vector search re-ranked by ms-marco cross-encoder",
      "search": {
        "reranker": {
          "package": "@vivantel/virage-reranker-cross-encoder",
          "config": {
            "model": "Xenova/ms-marco-MiniLM-L-6-v2",
